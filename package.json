{
  "name": "viboplr",
  "private": true,
  "version": "1.0.114-beta2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "deploy:site:vps": "pwsh -NoProfile -File scripts/deploy-site-vps.ps1",
    "bump": "node scripts/bump.mjs",
    "loc": "node scripts/loc.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "app:smoke": "node scripts/app-smoke.mjs",
    "perf:setup": "node scripts/setup-perf-profile.mjs",
    "lint": "eslint . --max-warnings 193",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:mcp": "vitest run src/__tests__/mcpContract.test.ts src/__tests__/mcpServer.test.ts src/__tests__/assistantTools.test.ts src/__tests__/controlApi.test.ts && cd src-tauri && cargo test --lib control_api::",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:all": "npm run lint && npm run test:rust && npm test && npm run test:e2e",
    "capture:media": "node scripts/capture-site-media.mjs",
    "short": "node scripts/make-short.mjs",
    "demo:library": "node scripts/make-demo-library.mjs",
    "demo:setup": "node scripts/setup-demo-profile.mjs",
    "eval:setup": "node scripts/assistant-eval.mjs setup",
    "eval:assistant": "node scripts/assistant-eval.mjs run",
    "screenshots": "playwright test --config tests/e2e/playwright.config.js tests/e2e/specs/screenshots.test.js && node scripts/convert-screenshots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
