{
  "name": "rqbit",
  "reason": "The BitTorrent client that performs each download",
  "required": true,
  "definition": {
    "description": "BitTorrent downloads (one-shot, no client to configure)",
    "versionArgs": [
      "--version"
    ],
    "versionPattern": "^rqbit (\\S+)",
    "install": {
      "macos": "brew install rqbit",
      "windows": "cargo install rqbit",
      "linux": "cargo install rqbit",
      "url": "https://github.com/ikatson/rqbit/releases/latest"
    },
    "managed": {
      "repo": "ikatson/rqbit",
      "assets": {
        "macos": "rqbit-osx-universal",
        "windows": "rqbit.exe",
        "linux-x64": "rqbit-linux-amd64",
        "linux-arm64": "rqbit-linux-arm64"
      },
      "checksum": {
        "none": true
      }
    }
  }
}
