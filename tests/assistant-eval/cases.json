          {
            "tool": "delete_tracks",
            "args": {
              "planHash": {
                "$present": true
              }
            }
          }
        ],
        "state": [
          {
            "sql": "SELECT COUNT(*) FROM tracks WHERE title = 'Foghorn Lullaby'",
            "at": "rows.0.0",
            "equals": 0
          }
        ]
      }
    },
